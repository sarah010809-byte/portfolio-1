                                         {
                                             "title_ko":  "Evolving, Game",
                                             "title_en":  "Evolving, Game",
                                             "year":  "2022–2023",
                                             "collaborator_ko":  "Collaboration with Zaid Shawwa",
                                             "collaborator_en":  "Collaboration with Zaid Shawwa",
                                             "medium_ko":  "",
